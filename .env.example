# All of these can also be set from the in-app Réglages page (stored in the
# local SQLite DB) instead of here — this file is only needed for Docker/CLI
# bootstrapping or server deployments. OPENROUTER_API_KEY is required to
# generate images or use the chat agent; everything else is optional.
# Everything not listed here (models, default resolution/aspect ratio,
# channel profile, appearance, agent behaviour, MCP…) is configured in the
# Réglages page itself, not through env vars.

# Image generation + chat agent — OpenRouter's Unified Image API and
# multi-model chat both go through this one key.
OPENROUTER_API_KEY=

# Voice dictation in the chat panel (Whisper transcription)
OPENAI_API_KEY=

# YouTube playlist import (swipe file sidebar / inspirations feed)
YOUTUBE_API_KEY=

# Google OAuth (Réglages → Connexions) — connecter « Ma chaîne »
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# MCP server bearer auth for external MCP clients (Claude Desktop, Claude Code…)
MCP_API_KEY=

# Optional password gate for the whole app
SITE_PASSWORD=

# Optional infra overrides
# THUMBGEN_DB_PATH=./data/thumbgen.db
# THUMBGEN_PUBLIC_HOST=your.host.example.com
